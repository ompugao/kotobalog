PORT=18081
BASE_URL=https://kotobalog.example.com
JWT_SECRET=please-change-this-secret-in-production

# Comma-separated identities allowed to sign in (e.g. github:ompugao,google:family@gmail.com)
ALLOWLIST=github:ompugao

# Optional: Google OAuth2
# Redirect URI: https://kotobalog.example.com/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: GitHub OAuth2
# Callback URL: https://kotobalog.example.com/api/auth/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
